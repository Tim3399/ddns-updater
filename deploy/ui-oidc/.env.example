DDNS_IMAGE=ghcr.io/Tim3399/ddns-updater@sha256:REPLACE_ME
OAUTH2_PROXY_IMAGE=quay.io/oauth2-proxy/oauth2-proxy:v7.15.4

# Generic OIDC. Keycloak example:
# https://auth.example.com/realms/homelab
OIDC_ISSUER_URL=https://auth.example.com/realms/homelab
OIDC_CLIENT_ID=ddns-updater

DDNS_EXTERNAL_URL=https://ddns.example.com

PERIOD=5m
UPDATE_COOLDOWN_PERIOD=5m
HTTP_TIMEOUT=10s

PUBLICIP_HTTP_PROVIDERS=ipify,icanhazip,nnev
PUBLICIPV4_HTTP_PROVIDERS=ipify,icanhazip,nnev
PUBLICIPV6_HTTP_PROVIDERS=ipify,icanhazip,nnev
